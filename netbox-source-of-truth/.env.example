# Copy this file to .env and replace every "replace-me" before the first start.
# cp .env.example .env
#
# .env is gitignored. .env.example is committed.

# --- NetBox container secrets -------------------------------------------------

# Django SECRET_KEY. Must be at least 50 characters.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
NETBOX_SECRET_KEY=replace-me

# Pepper applied to API token hashes (NetBox 4.6 / netbox-docker 5.x).
# Changing this after tokens exist invalidates every existing token.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NETBOX_API_TOKEN_PEPPER=replace-me

# Superuser created on first boot.
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@lab.local
NETBOX_SUPERUSER_PASSWORD=replace-me

# API token created for that superuser on first boot. Must be 40 hex characters.
# This is the same value the Ansible control node needs as NETBOX_TOKEN.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(20))"
NETBOX_TOKEN=replace-me

# --- Datastore passwords ------------------------------------------------------

POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
REDIS_CACHE_PASSWORD=replace-me

# --- Host binding -------------------------------------------------------------

# Port the NetBox UI and API listen on.
NETBOX_PORT=8000
