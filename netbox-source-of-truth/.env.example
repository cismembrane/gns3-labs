# Copy this file to .env and fill in NETBOX_TOKEN after the first start.
# cp .env.example .env
#
# .env is gitignored. .env.example is committed.

# --- NetBox container secrets -------------------------------------------------

# Django SECRET_KEY. Must be at least 50 characters.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NETBOX_SECRET_KEY=replace-me

# Pepper applied to API token hashes (NetBox 4.5+, netbox-docker 5.x).
# Must be at least 50 characters. Reaches the container as API_TOKEN_PEPPER_1
# and is read into API_TOKEN_PEPPERS by configuration.py; without it NetBox logs
# "API_TOKEN_PEPPERS is not defined. v2 API tokens cannot be used."
# Changing this after tokens exist invalidates every existing token.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NETBOX_API_TOKEN_PEPPER=replace-me

# Superuser created on first boot.
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@lab.local
NETBOX_SUPERUSER_PASSWORD=admin

# API token for the superuser. NetBox 4.5+ issues v2 tokens, whose plaintext is
# generated server-side, so this value cannot be chosen in advance. The
# netbox-docker SUPERUSER_API_TOKEN bootstrap does not produce a usable token on
# 4.5+ and must not be relied on.
#
# Bring the stack up first, then provision a token and paste the full
# nbt_<key>.<plaintext> value below:
#
#   curl -s -X POST http://localhost:8000/api/users/tokens/provision/ \
#     -H "Content-Type: application/json" \
#     -d '{"username":"admin","password":"admin"}'
#
# This is the same value the Ansible control node needs as NETBOX_TOKEN.
NETBOX_TOKEN=replace-me

# --- Datastore passwords ------------------------------------------------------
# Baked into the postgres volume on first init. Changing these against an
# existing volume breaks the NetBox container's DB connection; rotate only
# alongside a `docker compose down -v`.
POSTGRES_PASSWORD=admin
REDIS_PASSWORD=admin
REDIS_CACHE_PASSWORD=admin

# --- Host binding -------------------------------------------------------------
# Port the NetBox UI and API listen on.
NETBOX_PORT=8000
