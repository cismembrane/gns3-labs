{#
  BGP rendered from the NetBox config context. asn, router_id, bgp_neighbors and
  bgp_networks come from the `compose` block in inventory/netbox.yml.

  Not sorted, unlike interfaces.j2: both render paths read the same config
  context JSON, so list order is already stable, and sorting networks lexically
  would put a transit /29 ahead of the loopback.

  `address-family ipv4`, not `ipv4 unicast`. IOS accepts both and prints the
  short form, and drift.yml compares against what the device prints.
#}
router bgp {{ asn }}
 bgp router-id {{ router_id }}
 bgp log-neighbor-changes
{% for peer in bgp_neighbors %}
 neighbor {{ peer.neighbor }} remote-as {{ peer.remote_as }}
 neighbor {{ peer.neighbor }} description {{ peer.description }}
{% endfor %}
 address-family ipv4
{% for net in bgp_networks %}
  network {{ net.prefix }} mask {{ net.mask }}
{% endfor %}
{% for peer in bgp_neighbors %}
  neighbor {{ peer.neighbor }} activate
{% endfor %}
 exit-address-family
